# Kopier denne filen til ".env" (uten .example) og fyll inn dine verdier.
# .env er ignorert av git, så hemmelighetene dine blir aldri pushet.

# MET Norge Frost API — gratis, registreres på:
#   https://frost.met.no/auth/requestCredentials.html
# Når brukeren er opprettet får du en klient-ID. Lim den inn under.
# Hvis ikke satt, hopper pipelinen Frost-fasen gracefully over.
FROST_CLIENT_ID=
